{{- $tableData := . -}}
{{- $headers := .Header -}}
<ansi fg="black-bold">.:</ansi> <ansi fg="table-title">{{ splitstring .Title (sub screenwidth 3) "   " }}</ansi>
{{ range $rowIndex, $row := .Rows }}<ansi fg="shop-{{ lowercase (index $headers 0) }}">{{ splitstring (index $row 0) screenwidth }}</ansi>
