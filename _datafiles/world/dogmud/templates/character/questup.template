{{/* Rules span the screen (79 stars at 80 and wider, as a desktop always saw
them) and the text wraps inside them at indent 1 (plan 3b-3). No forms: one
layout fits every width. */}}{{ $r := screenwidth }}{{ if ge $r 80 }}{{ $r = 79 }}{{ end }}
<ansi fg="magenta-bold">{{ repeat "*" $r }}</ansi>

<ansi fg="yellow"> {{ wrapspans . (sub $r 1) " " }}</ansi>
<ansi fg="yellow"> {{ wrapspans `type <ansi fg="command">quests</ansi> to track your progress on quests.` (sub $r 1) " " }}</ansi>

<ansi fg="magenta-bold">{{ repeat "*" $r }}</ansi>
