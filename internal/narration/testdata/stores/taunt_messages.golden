# taunt-messages store snapshot
# files at time of writing: 2 (rhetoric,wordless)
# dimensions: intensity(hit/miss/critical/fumble) x perspective(actor/actee/observer)
#
# All three perspectives of one intensity come from ONE coordinated GetTauntTriad call
# (same variant index across the triad). Until 2026-09-09 usercommands/taunt.go called a
# per-perspective getter three times and got three INDEPENDENT indices, so the three
# audiences were narrated three different moments -- the same defect PR #112 fixed for
# melee defence. A fresh SequencePicker per intensity pins index 0.
#
# This snapshot pins index 0 only, so it CANNOT see a regression back to independent
# picks (all three would still read index 0). That is guarded by
# TestGetTauntTriadUsesOneCoordinatedIndex in internal/combat, which shares one
# SequencePicker across the triad so three picks yield 0/1/2 and one pick yields 0/0/0.

rhetoric|hit|actor => You sneer at <ansi fg="Mob">Target</ansi>, and your words cut deep! (<ansi fg="damage">ModerateWounds</ansi>)
rhetoric|hit|actee => <ansi fg="User">Source</ansi>'s taunt cuts deep, shaking your resolve! (<ansi fg="damage">ModerateWounds</ansi>)
rhetoric|hit|observer => <ansi fg="User">Source</ansi> sneers at <ansi fg="Mob">Target</ansi> with contempt!
rhetoric|miss|actor => Your taunt falls flat against <ansi fg="Mob">Target</ansi>.
rhetoric|miss|actee => <ansi fg="User">Source</ansi> tries to taunt you, but it has no effect.
rhetoric|miss|observer => <ansi fg="User">Source</ansi> tries to taunt <ansi fg="Mob">Target</ansi>, but it falls flat.
rhetoric|critical|actor => Your words strike like a blade — <ansi fg="Mob">Target</ansi> recoils in shock! (<ansi fg="damage">ModerateWounds</ansi>) <ansi fg="yellow">[CRIT!]</ansi>
rhetoric|critical|actee => <ansi fg="User">Source</ansi>'s words cut to the bone — you reel in shock! (<ansi fg="damage">ModerateWounds</ansi>) <ansi fg="yellow">[CRIT!]</ansi>
rhetoric|critical|observer => <ansi fg="User">Source</ansi>'s words strike like a blade — <ansi fg="Mob">Target</ansi> recoils!
rhetoric|fumble|actor => <ansi fg="red">You stumble over your words trying to taunt <ansi fg="Mob">Target</ansi> — how embarrassing!</ansi>
rhetoric|fumble|actee => <ansi fg="green"><ansi fg="User">Source</ansi> tries to taunt you but fumbles their words!</ansi>
rhetoric|fumble|observer => <ansi fg="User">Source</ansi> stumbles over their words trying to taunt <ansi fg="Mob">Target</ansi>.
wordless|hit|actor => You snarl at <ansi fg="Mob">Target</ansi> until their nerve cracks! (<ansi fg="damage">ModerateWounds</ansi>)
wordless|hit|actee => <ansi fg="User">Source</ansi> snarls at you until your nerve cracks! (<ansi fg="damage">ModerateWounds</ansi>)
wordless|hit|observer => <ansi fg="User">Source</ansi> snarls at <ansi fg="Mob">Target</ansi> until their nerve cracks!
wordless|miss|actor => Your snarl barely reaches <ansi fg="Mob">Target</ansi>, who is unmoved.
wordless|miss|actee => <ansi fg="User">Source</ansi> snarls at you, but it barely reaches you.
wordless|miss|observer => <ansi fg="User">Source</ansi> snarls at <ansi fg="Mob">Target</ansi>, who is unmoved.
wordless|critical|actor => Your roar crashes over <ansi fg="Mob">Target</ansi>, who reels! (<ansi fg="damage">ModerateWounds</ansi>) <ansi fg="yellow">[CRIT!]</ansi>
wordless|critical|actee => <ansi fg="User">Source</ansi>'s roar crashes over you, and you reel! (<ansi fg="damage">ModerateWounds</ansi>) <ansi fg="yellow">[CRIT!]</ansi>
wordless|critical|observer => <ansi fg="User">Source</ansi>'s roar crashes over <ansi fg="Mob">Target</ansi>, who reels!
wordless|fumble|actor => <ansi fg="red">Your snarl breaks into a cough. <ansi fg="Mob">Target</ansi> stares at you.</ansi>
wordless|fumble|actee => <ansi fg="green"><ansi fg="User">Source</ansi>'s snarl at you breaks into a cough.</ansi>
wordless|fumble|observer => <ansi fg="User">Source</ansi>'s snarl at <ansi fg="Mob">Target</ansi> breaks into a cough.
