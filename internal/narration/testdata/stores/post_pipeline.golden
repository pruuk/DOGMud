# post-pipeline snapshot: internal/messaging.RenderForRecipient + Verbosity.Suppresses
# This catches the class a raw-store snapshot cannot see: the text survived unchanged but
# WHO receives it, or what a blinded/deafened player sees, quietly changed.
# PARTIAL NET: sweeps a representative subset of Category (~15 of the real ~60+ — categoryMax
# is unexported so the full enum cannot be walked from outside internal/messaging).
# dimensions (RenderForRecipient section): sample-line x SightDecision(full/shapes/none) x
# Channel(visual/audio). dimensions (Verbosity section): representative-category x
# Verbosity(full/medium/light) -> bool suppressed.

render|hit-melee-with-name-tags|channel=visual|sight=full => "<ansi fg=\"hit-melee\"><ansi fg=\"username\">Target</ansi> is struck hard by <ansi fg=\"username\">Source</ansi>.</ansi>"
render|hit-melee-with-name-tags|channel=visual|sight=shapes => "<ansi fg=\"hit-melee\"><ansi fg=\"combat-anon\">a figure</ansi> is struck hard by <ansi fg=\"combat-anon\">a figure</ansi>.</ansi>"
render|hit-melee-with-name-tags|channel=visual|sight=none => ""
render|hit-melee-with-name-tags|channel=audio|sight=full => "<ansi fg=\"hit-melee\"><ansi fg=\"username\">Target</ansi> is struck hard by <ansi fg=\"username\">Source</ansi>.</ansi>"
render|hit-melee-with-name-tags|channel=audio|sight=shapes => "<ansi fg=\"hit-melee\"><ansi fg=\"username\">Target</ansi> is struck hard by <ansi fg=\"username\">Source</ansi>.</ansi>"
render|hit-melee-with-name-tags|channel=audio|sight=none => "<ansi fg=\"hit-melee\"><ansi fg=\"username\">Target</ansi> is struck hard by <ansi fg=\"username\">Source</ansi>.</ansi>"
render|room-description|channel=visual|sight=full => "<ansi fg=\"room-description\">The cave is dark and damp, water dripping steadily from unseen cracks.</ansi>"
render|room-description|channel=visual|sight=shapes => "<ansi fg=\"room-description\">The cave is dark and damp, water dripping steadily from unseen cracks.</ansi>"
render|room-description|channel=visual|sight=none => ""
render|room-description|channel=audio|sight=full => "<ansi fg=\"room-description\">The cave is dark and damp, water dripping steadily from unseen cracks.</ansi>"
render|room-description|channel=audio|sight=shapes => "<ansi fg=\"room-description\">The cave is dark and damp, water dripping steadily from unseen cracks.</ansi>"
render|room-description|channel=audio|sight=none => "<ansi fg=\"room-description\">The cave is dark and damp, water dripping steadily from unseen cracks.</ansi>"
render|dodge|channel=visual|sight=full => "<ansi fg=\"dodge\">You dodge the attack.</ansi>"
render|dodge|channel=visual|sight=shapes => "<ansi fg=\"dodge\">You dodge the attack.</ansi>"
render|dodge|channel=visual|sight=none => ""
render|dodge|channel=audio|sight=full => "<ansi fg=\"dodge\">You dodge the attack.</ansi>"
render|dodge|channel=audio|sight=shapes => "<ansi fg=\"dodge\">You dodge the attack.</ansi>"
render|dodge|channel=audio|sight=none => "<ansi fg=\"dodge\">You dodge the attack.</ansi>"

